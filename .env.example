# ---------------------------------------------------------------------------
# Nibrexo OS AI — Environment Configuration
# Reference only. NEVER commit real values (PDF #11 §6 Secrets & API Keys).
# ---------------------------------------------------------------------------

# --- Supabase (PDF #12 §4) -------------------------------------------------
# Required in every Vercel environment where browser auth is enabled.
NEXT_PUBLIC_SUPABASE_URL=
# Legacy key name (supported for existing projects):
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Current Supabase/Vercel integration key name (supported as a safe fallback):
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only privileged job key. Either current or legacy name is supported;
# never expose either key through a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# --- AI layer (PDF #02 §7 / PDF #08) ---------------------------------------
# When unset, the Manager runs its deterministic planner and records
# `ai_enabled: false` on the task trace. It never emulates an LLM result.
NIBREXO_AI_PROVIDER=openai
OPENAI_API_KEY=
NIBREXO_AI_MODEL=gpt-4o-mini

# --- Data backend ----------------------------------------------------------
# supabase (default, production) | memory (local dev / tests only)
# `memory` refuses to start when NODE_ENV=production.
NIBREXO_DATA_BACKEND=supabase

# --- Dev-only escape hatches (must be unset in production) -----------------
# Allows a local identity without a real Supabase session.
NIBREXO_DEV_AUTH=0
# Seed organization id used by the dev identity.
NIBREXO_DEV_ORG_ID=00000000-0000-0000-0000-000000000001

# --- Social OAuth (Phase 7, all server-only) --------------------------------
# AES-256 key protecting stored provider tokens: 32 bytes as 64 hex chars (or
# base64). Generate with: openssl rand -hex 32. Required in production;
# without it, connecting an account is refused. Never expose to the browser.
NIBREXO_TOKEN_ENCRYPTION_KEY=
# Public app origin used to build OAuth redirect URIs
# ({origin}/api/workspace/social/callback/{platform}). Register each full URI
# in the matching provider dashboard. Falls back to the request origin.
NIBREXO_APP_URL=
# One pair per platform; a platform without its pair reports `not_configured`.
NIBREXO_TIKTOK_CLIENT_KEY=
NIBREXO_TIKTOK_CLIENT_SECRET=
NIBREXO_GOOGLE_CLIENT_ID=
NIBREXO_GOOGLE_CLIENT_SECRET=
NIBREXO_PINTEREST_CLIENT_ID=
NIBREXO_PINTEREST_CLIENT_SECRET=
NIBREXO_LINKEDIN_CLIENT_ID=
NIBREXO_LINKEDIN_CLIENT_SECRET=
NIBREXO_INSTAGRAM_CLIENT_ID=
NIBREXO_INSTAGRAM_CLIENT_SECRET=
NIBREXO_META_CLIENT_ID=
NIBREXO_META_CLIENT_SECRET=
# Shared secret authorizing the publish sweeper (GET|POST /api/cron/publish).
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` automatically when
# that variable is set, so it takes precedence; NIBREXO_CRON_SECRET is the
# alias for any other scheduler. Generate with: openssl rand -hex 32.
# The sweep trigger itself is operator-configured (no vercel.json cron ships
# with the repo: Hobby plans allow only daily crons, which is too coarse for
# a publishing scheduler). Options: Vercel Cron on Pro with
# `{"path": "/api/cron/publish", "schedule": "*/5 * * * *"}`, or any external
# scheduler calling the endpoint with the bearer secret every ~5 minutes.
# Without a trigger, scheduled posts stay queued until the endpoint is hit.
CRON_SECRET=
# NIBREXO_CRON_SECRET=

# --- Email delivery (Phase 10, server-only) ---------------------------------
# Production email is delivered through Resend (https://resend.com).
# Verified per 2026-10-07 against https://resend.com/docs/api-reference/emails/send-email
# and https://resend.com/docs/dashboard/emails/idempotency-keys.
#   NIBREXO_EMAIL_PROVIDER=resend  — selects the Resend adapter; any other value
#     keeps delivery disabled (emails can still be prepared/previewed, not sent).
#   RESEND_API_KEY=re_...          — server-only bearer token; never exposed to the browser.
#   NIBREXO_EMAIL_FROM="Acme <onboarding@resend.dev>" — must be a verified domain
#     (or onboarding@resend.dev for testing); Rejects with 403 if unverified.
# Rate limit: 10 req/s per team (429 retry-after), idempotency via Idempotency-Key
# header (24h, 256 char max). Missing/invalid credentials report not_configured.
NIBREXO_EMAIL_PROVIDER=
RESEND_API_KEY=
NIBREXO_EMAIL_FROM=

# --- Email Studio asset links (Phase 16, server-only) ----------------------
# Private Content Library files are rendered into emails through short-lived
# HMAC-signed URLs (/api/workspace/email/assets/<mediaId>?exp&org&sig) instead
# of public bucket URLs. The signing secret must be identical in every process
# that mints or verifies a link.
#   NIBREXO_EMAIL_ASSET_SECRET=<32+ random bytes> — dedicated secret for these
#     links. Generate with: openssl rand -hex 32
# When unset, the studio derives one from NIBREXO_TOKEN_ENCRYPTION_KEY or the
# Supabase credentials. If none of those exist either (local dev with the
# in-memory backend) a per-process secret is used: links work inside that
# process and stop resolving after a restart. Set this variable before running
# more than one server instance, or images will break unpredictably.
NIBREXO_EMAIL_ASSET_SECRET=
