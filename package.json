{
  "name": "nibrexo-os-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Nibrexo OS AI \u2014 central NIBREXO CEO / Manager Agent: one autonomous Manager with modular skills, orchestration, verification, quality control and business operations.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "auth:status": "tsx scripts/provision-owner.ts",
    "auth:provision": "tsx scripts/provision-owner.ts --apply",
    "verify": "npm run typecheck && npm run lint && npm test",
    "verify:schema": "node scripts/verify-schema-pglite.mjs",
    "db:sql": "node scripts/emit-migrations.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.3.22",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.10",
    "ai": "^4.3.19",
    "next": "^15.5.27",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitest/coverage-v8": "^3.0.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.5.27",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
